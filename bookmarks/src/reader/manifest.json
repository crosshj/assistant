{
    "name": "Reader - SmartText Database Manager",
    "short_name": "Reader",
    "start_url": "./reader.html",
    "display": "standalone",
    "background_color": "#ffffff",
    "theme_color": "#2563eb",
    "description": "A PWA for managing .smartText database files with dynamic UI generation",
    "icons": [
        {
            "src": "favicon.svg",
            "sizes": "192x192",
            "type": "image/svg+xml",
            "purpose": "any maskable"
        },
        {
            "src": "favicon.svg",
            "sizes": "512x512",
            "type": "image/svg+xml",
            "purpose": "any maskable"
        }
    ],
    "file_handlers": [
        {
            "action": "./reader.html",
            "accept": {
                "application/sqlite": [".smartText"]
            }
        }
    ],
    "categories": ["productivity", "utilities"],
    "lang": "en",
    "orientation": "portrait-primary",
    "scope": "./",
    "id": "reader-smarttext-manager"
}
