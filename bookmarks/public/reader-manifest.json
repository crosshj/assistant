{
    "name": "Reader - SmartText Database Manager",
    "short_name": "Reader",
    "start_url": "/reader",
    "display": "standalone",
    "background_color": "#202020",
    "theme_color": "#202020",
    "description": "A PWA for managing .smartText database files with dynamic UI generation",
    "icons": [
        {
            "src": "/reader-favicon.svg",
            "sizes": "192x192",
            "type": "image/svg+xml"
        },
        {
            "src": "/reader-favicon.svg",
            "sizes": "512x512",
            "type": "image/svg+xml"
        }
    ],
    "file_handlers": [
        {
            "action": "/reader",
            "accept": {
                "application/sqlite": [".smartText"]
            }
        }
    ],
    "categories": ["productivity", "utilities"],
    "lang": "en",
    "orientation": "portrait-primary",
    "scope": "/reader",
    "id": "reader-smarttext-manager"
}
